{
  "name": "lick-migrate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One-shot migration: user_licks.json -> POST /v1/licks on the Jazzify backend",
  "scripts": {
    "migrate": "tsx src/migrate.ts",
