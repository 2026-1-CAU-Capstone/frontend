# Frontend 환경변수 템플릿
# 복사: cp .env.example .env  → 실제 값 채워서 사용 (.env 는 gitignore됨)

# ── LLM 키 ─────────────────────────────────────────────────────────────────
# 주의: 클라이언트 번들에 노출됩니다. 정식 백엔드 도입 시 서버 사이드로 옮기세요.
VITE_ANTHROPIC_API_KEY=

# ── RAG 서버 ────────────────────────────────────────────────────────────────
# 비워두면 http://127.0.0.1:8001 (로컬 dev) 로 폴백.
#   - 임시 Mac mini: https://xxxxx.trycloudflare.com  (Quick Tunnel)
#   - 또는:          https://rag.<본인도메인>.com    (Named Tunnel)
#   - 백엔드 정식화: https://api.jazzify.com          (이 줄만 교체)
VITE_RAG_BASE=

# (선택) Bearer 토큰 — 비우면 헤더 안 붙음. tmp-rag-server/.env 의
# RAG_AUTH_TOKEN 과 같은 값을 넣어두세요.
VITE_RAG_TOKEN=
